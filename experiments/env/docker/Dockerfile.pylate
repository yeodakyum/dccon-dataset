# KURE-v2 late-interaction track (pylate pins sentence-transformers==5.3.0).
# torch 2.11: pylate's fast-plaid dependency is built only for torch <= 2.11.
FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
# The image's system Python is PEP 668-managed; installing into it is fine in a container.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
COPY requirements-pylate.txt /tmp/
RUN pip freeze | grep -E '^torch==' > /tmp/constraints.txt \
 && pip install --no-cache-dir -c /tmp/constraints.txt -r /tmp/requirements-pylate.txt
ENV HF_HOME=/hf HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
WORKDIR /work
